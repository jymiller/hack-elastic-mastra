{
  "name": "hack-elastic-mastra",
  "version": "0.1.0",
  "private": true,
  "description": "Great Questions AI: a living research brain for evolving ideas and better questions.",
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "ask": "node --env-file-if-exists=.env --import tsx scripts/ask.ts",
    "check:elastic": "node --env-file-if-exists=.env --import tsx scripts/check-elastic.ts",
    "inspect:elastic": "node --env-file-if-exists=.env --import tsx scripts/inspect-elastic.ts",
    "setup:elastic": "node --env-file-if-exists=.env --import tsx scripts/setup-elastic.ts",
    "ingest:podcast": "node --env-file-if-exists=.env --import tsx scripts/ingest-podcast-transcripts.ts"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@elastic/elasticsearch": "9.5.0",
    "@mastra/core": "1.60.0",
    "@mastra/libsql": "1.21.0",
    "@mastra/mcp": "1.17.0",
    "@mastra/memory": "1.27.0",
    "@mastra/observability": "1.17.1",
    "@openrouter/ai-sdk-provider": "2.7.0",
    "ai": "6.0.259",
    "qrcode": "1.5.4",
    "unpdf": "1.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/qrcode": "1.5.6",
    "mastra": "1.25.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
